-- The reference lines in order: the RichText-marked ones when marked is true, otherwise the plain text. A fresh list each call.
function CreditsData.referenceLines(marked)
	local lines = {}
	for _, ref in ipairs(CreditsData.references) do
		table.insert(lines, marked and ref.marked or ref.text)
	end
	return lines
end

-- Licence and ownership notices shown with the references. ASCII only.
CreditsData.noticeLines = {
	"Map data (c) OpenStreetMap contributors, available under the Open Database License (ODbL 1.0): https://www.openstreetmap.org/copyright",
	"Imagery and map data from Google Maps, Google Earth and Street View belong to Google and its data providers.",
	"Wikimedia Commons photographs keep the licence named in their reference (CC BY-SA 3.0, CC BY-SA 4.0 or CC0).",
	"Reference photos also come from the sites themselves and public web pages; they were used only as visual reference and no photo is used as a texture in the experience.",
}

-- Student identity for the board. pending = true shows the TO BE ADDED slot; set it false once all three are filled.
CreditsData.identity = { name = "", course = "", section = "", pending = true }

local PENDING_TEXT = "Name / Course / Section: TO BE ADDED"

local function filled(s)
	return type(s) == "string" and string.match(s, "%S") ~= nil
end

function CreditsData.identityText()
	local id = CreditsData.identity
	if id.pending or not (filled(id.name) and filled(id.course) and filled(id.section)) then
		return PENDING_TEXT
	end
	return id.name .. " - " .. id.course .. " - " .. id.section
end

-- Printable lines for the board: a title, one block per site (name then its source urls), then the identity slot.
-- `sites` is SiteData.sites; a missing site falls back to "Site N" instead of erroring.
function CreditsData.boardLines(sites)
	local names = {}
	for _, s in ipairs(sites or {}) do
		names[s.id] = s.name
	end
	local lines = { "PHOTO AND SOURCE CREDITS" }
	for _, entry in ipairs(CreditsData.sites) do
		table.insert(lines, entry.id .. ". " .. (names[entry.id] or ("Site " .. entry.id)))
		for _, url in ipairs(entry.urls) do
			table.insert(lines, url)
		end
	end
	table.insert(lines, CreditsData.identityText())
	return lines
end

return CreditsData
